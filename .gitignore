# --- 국방 대시보드 팀 프로젝트 추가 보안 및 데이터 관리 ---

# 로컬 SQLite 데이터베이스 파일 (100MB 용량 제한 대응)
data/*.db
data/*.sqlite

# 빅쿼리(BigQuery) 등 서비스 계정 인증 JSON 키 및 비밀키 폴더
*.json
secrets/

# SSH 키 파일 차단
*.pem

# 원본 데이터 폴더 차단 (내부 README만 예외 허용)
data/raw/*
!data/raw/README.md

# 가공된 데이터 및 벡터DB 등 대용량 파일 차단
data/processed/*.db
data/processed/chroma/
data/processed/_*
data/processed/fund_chunks/

!data/processed/*.csv

# 운영체제 생성 파일 및 로그
.DS_Store
*.log

# .vscode /* 환경 고정 커밋 금지
# 3 : 1 환경 기준
.vscode/*
!.vscode/settings.default.json

# --- 긴장도 코드화 (2026-10-28, F0) ---
# 로컬 작업 폴더: 재현 스크립트·백업·중간 CSV (결정 문서 정본은 docs/tension/ 사본 — U8 10-28)
진행 현황 및 계획 정리/
# 사건표는 로컬 원자료에서 만든 입력 — 깃에 올리지 않음(D1). 결과 CSV·유형판정표·GPR 월별은 올림
data/tension/events_*.csv
# 밑줄로 시작하는 중간 파일(기존 data/processed/_* 규칙과 같은 방식)
data/tension/_*
